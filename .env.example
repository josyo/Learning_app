# --- Database (Neon) -------------------------------------------------
# Branch layout: main = PRODUCTION (real trainee data), dev = copy of
# production for dry-runs and imports, test = wiped by test:e2e:setup.
# THIS file (.env) points at the **dev** branch. Never at main.
#
# DATABASE_URL: the dev branch's POOLED URL (host contains "-pooler").
# DIRECT_URL:   the same branch's DIRECT URL (same host without "-pooler");
#               Prisma Migrate needs it, pooled URLs are unreliable for migrations.
# Both must be the same branch. Scripts refuse to run otherwise, and refuse
# production outright (see lib/db-targets.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Use a unique secret per environment. Dev/test/prod must not share the same secret.
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded local accounts are for development/test use only. Set a single
# strong password here for the default demo accounts unless you want to
# override per-role credentials with the optional variables below.
SEED_USER_PASSWORD="set-a-strong-local-seed-password"
# Optional per-account overrides:
# SEED_ADMIN_PASSWORD="set-a-strong-admin-seed-password"
# SEED_MENTOR_PASSWORD="set-a-strong-mentor-seed-password"
# SEED_TRAINEE_PASSWORD="set-a-strong-trainee-seed-password"
