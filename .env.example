# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dev_learning_platform"

# Better Auth
# Use a unique secret per environment. Dev/test/prod must not share the same secret.
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded local accounts are for development only. Set a unique password here
# for the default seed users instead of using a public/shared value.
SEED_PASSWORD="set-a-strong-local-seed-password"
