{
  "name": "dev-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "import:content": "tsx prisma/import-content.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:setup": "npm run db:migrate:test && npm run db:seed:test && npm run import:content:test",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:seed:test": "dotenv -e .env.test -- tsx prisma/seed.ts",
    "import:content:test": "dotenv -e .env.test -- tsx prisma/import-content.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "better-auth": "^1.1.0",
    "@prisma/client": "^6.1.0",
    "zod": "^3.24.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "@tailwindcss/typography": "^0.5.15",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@testing-library/react": "^16.1.0",
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.0",
    "dotenv-cli": "^7.4.0"
  }
}