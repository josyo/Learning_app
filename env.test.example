# Template for .env.test — points at the Neon **test** branch, used only by
# the Playwright E2E suite and the *:test scripts. Copy to .env.test and fill
# in real values; .env.test is gitignored.
#
# The test branch is WIPED AND RESEEDED by `npm run test:e2e:setup`, so it
# must be a different branch from both dev (.env) and main (production). The
# guards (scripts/db-guard.ts, playwright.config.ts) refuse to start if the
# target matches .env or the production host.
#
# Set BOTH URLs. If DIRECT_URL is missing here, Prisma falls back to the
# one in .env (dev) and the guards will refuse.
DATABASE_URL="postgresql://USER:PASSWORD@ep-TEST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-TEST.REGION.aws.neon.tech/neondb?sslmode=require"

# Use a DIFFERENT secret than your dev environment. Dev/test/prod
# should each have a unique Better Auth secret.
BETTER_AUTH_SECRET="generate-a-long-random-string-for-test"
BETTER_AUTH_URL="http://localhost:3000"

# Seed credentials for the throwaway test database must also be unique and
# not reused from the dev database. This should not be a public default.
SEED_USER_PASSWORD="set-a-strong-test-seed-password"
