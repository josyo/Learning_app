# Template for .env.test — a SEPARATE database used only by the
# Playwright E2E suite, so `npm run test:e2e` never touches your real
# dev database. Copy this to .env.test and fill in real values;
# .env.test itself is gitignored, same as .env.local.

# Point this at a DIFFERENT database name than your real dev DB —
# e.g. if your dev DB is "dev_learning_platform", use
# "dev_learning_platform_test" here. The E2E setup script below
# creates the schema and seed data in it; nothing here should ever
# point at data you care about keeping.
DATABASE_URL="postgresql://user:password@localhost:5432/dev_learning_platform_test"

# Use a DIFFERENT secret than your dev environment. Dev/test/prod
# should each have a unique Better Auth secret.
BETTER_AUTH_SECRET="generate-a-long-random-string-for-test"
BETTER_AUTH_URL="http://localhost:3000"

# Seed credentials for the throwaway test database must also be unique and
# not reused from the dev database. This should not be a public default.
SEED_USER_PASSWORD="set-a-strong-test-seed-password"
